# Privacy Shield Configuration

# Backend Settings
BACKEND_DEBUG=false
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_RELOAD=false

# Frontend Settings
FRONTEND_URL=http://localhost:3000

# Dataset Settings
DATASET_PATH=./data/Base.csv
DATASET_SAMPLE_SIZE=10000
DATASET_RANDOM_SEED=42

# ML Training Settings
ML_RANDOM_SEED=42
ML_TEST_SIZE=0.15
ML_VAL_SIZE=0.15

# Baseline Model Settings
BASELINE_EPOCHS=50
BASELINE_BATCH_SIZE=32
BASELINE_LEARNING_RATE=0.001
BASELINE_HIDDEN_LAYERS=3
BASELINE_HIDDEN_DIM=256
BASELINE_DROPOUT=0.3

# DP-SGD Settings
DP_EPSILON=1.0
DP_DELTA=1e-6
DP_MAX_GRAD_NORM=1.0
DP_NOISE_MULTIPLIER=0.5

# LDP Settings
LDP_EPSILON=1.0

# Compression Settings
COMPRESSION_RATIO=0.8

# MIA Settings
MIA_NUM_QUERIES=1000
MIA_BATCH_SIZE=32

# API Settings
API_RATE_LIMIT=100
API_RATE_LIMIT_WINDOW=60

# Security Settings
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Storage Settings
STORAGE_PATH=./data/experiments
STORAGE_MODELS_PATH=./data/models
